# Copy to .env.deploy and replace every CHANGE_ME value. Never commit .env.deploy.
# Use URL-safe hexadecimal values so the password is valid inside DISCLOSURE_DATABASE_URL.
DEPLOY_POSTGRES_PASSWORD=CHANGE_ME_URL_SAFE_HEX
CLOVASTUDIO_API_KEY=CHANGE_ME_CLOVA_SERVICE_KEY
DISCLOSURE_API_TOKEN=CHANGE_ME_RANDOM_64_HEX
DISCLOSURE_API_PORT=8000
