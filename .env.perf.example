# Isolated PostgreSQL used only by perf/canonical-pipeline.
PERF_POSTGRES_DB=disclosure_perf
PERF_POSTGRES_USER=disclosure_perf
PERF_POSTGRES_PASSWORD=disclosure_perf_dev
PERF_POSTGRES_PORT=55432

# Host-side Python/Alembic connection. Do not point this at the model/data-pipeline DB.
PERF_DATABASE_URL=postgresql+psycopg://disclosure_perf:disclosure_perf_dev@localhost:55432/disclosure_perf

# Query-time CLOVA Studio Embedding v2 key. Keep the real value only in .env.perf.
CLOVASTUDIO_API_KEY=
