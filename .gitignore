# Environment variables and secrets
.env
.env.*
!.env.example
!.env.perf.example

# Python virtual environments
.venv/
venv/
env/
ENV/

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Build and package outputs
build/
dist/
*.egg-info/
.eggs/

# Test and quality-tool cache
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.ruff_cache/
.mypy_cache/
.pyright/
.tox/
.nox/

# Jupyter
.ipynb_checkpoints/

# Local databases
*.db
*.sqlite
*.sqlite3

# Generated disclosure data
/data/raw/**
/data/canonical/**
/data/processed/**
/data/retrieval/**
/data/quality/**

# Preserve empty data directories
!/data/raw/.gitkeep
!/data/canonical/.gitkeep
!/data/retrieval/.gitkeep
!/data/quality/.gitkeep

# Logs and temporary files
*.log
*.tmp
*.temp
tmp/
temp/

# IDE settings
.vscode/
.idea/

# Operating system files
.DS_Store
Thumbs.db
desktop.ini
